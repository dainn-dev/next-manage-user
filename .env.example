# ========================================
# FRONTEND (Next.js) ENVIRONMENT TEMPLATE
# ========================================
# Copy this file to .env.local and adjust as needed.
# This is the minimal template - see sample.env for the full variable list.
# All variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# API Configuration (single source of truth for REST + WebSocket).
# Must point at the backend Jetty port (default 8080).
NEXT_PUBLIC_API_URL=http://localhost:8080