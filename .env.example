# ========================================
# FRONTEND (Next.js) ENVIRONMENT TEMPLATE
# ========================================
# Copy this file to .env.local and adjust as needed.
# This is the minimal template - see sample.env for the full variable list.
# All variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# API Configuration (single source of truth for REST + WebSocket).
# Must point at the backend Jetty port (default 8080).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Gate API key. Sent as the X-Gate-Key header when the frontend calls the
# side-effecting parking-gate endpoint POST /api/vehicles/check-vehicle.
# Must match the backend GATE_API_KEY. Requires the NEXT_PUBLIC_ prefix so the
# browser can read it; treat it as an internal-only shared secret.
NEXT_PUBLIC_GATE_API_KEY=