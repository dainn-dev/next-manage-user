flowchart TD
    A["New confirmed slot assignment\n(from 11_Parking_Slot_Detection): identity + slot_id"] --> B{"Identity resolution:\ntrack_id continuous?"}
    B -->|"yes, same track_id"| C["Identity = track_id"]
    B -->|"track lost / new track"| D["Attempt plate re-identification\n(see track-plate reconciliation diagram)"]
    D --> C
    C --> E["Look up Vehicle.current_slot_id for this identity"]
    E --> F{"new slot_id == current_slot_id?"}
    F -->|yes| G["No-op: same slot, refresh last_seen_at"]
    F -->|no| H{"New slot stable for debounce window\nAND old slot vacated?"}
    H -->|no| I["Hold - possible boundary jitter, do not emit yet"]
    H -->|yes| J{"Within dedup window since last\nrelocation for this identity?"}
    J -->|yes| K["Suppress duplicate - log only"]
    J -->|no| L["Emit VehicleRelocated\n(old_slot,new_slot,track_id,plate,confidence)"]
    L --> M["Update Vehicle.current_slot_id"]
    L --> N["Write ParkingHistory(old_slot,new_slot,occurred_at)"]
    L --> O["Save snapshot(s): old slot + new slot"]
    L --> P["Publish to event bus -> Notification\n(car moved / stolen?)"]

    classDef new fill:#ffe0b2,stroke:#e65100,color:#7a3e00,stroke-dasharray: 4 3;
    class A,B,C,D,E,F,G,H,I,J,K,L,M,N,O,P new;
