flowchart TD
    A["ByteTrack: track lost\n(occlusion / left FOV / process restart)"] --> B["Query recent detections at same camera\nwithin a short time window"]
    B --> C{"Plate string available on\nlost track's last frames?"}
    C -->|no| D["Cannot reconcile - treat next\ndetection as a new track (no relocation inferred)"]
    C -->|yes| E["Search candidate new tracks for matching plate\n(exact or edit-distance <= 1 to tolerate OCR noise)"]
    E --> F{"Match found?"}
    F -->|no| G["No reconciliation - new track_id is a\ndistinct identity until proven otherwise"]
    F -->|"yes, same camera"| H["Re-bind identity: continue relocation\nlogic with new track_id, same plate"]
    F -->|"yes, different camera at same site"| I["Cross-camera handoff - correlate at backend\nby plate (edge is per-camera process)"]
    I --> H

    classDef new fill:#ffe0b2,stroke:#e65100,color:#7a3e00,stroke-dasharray: 4 3;
    class A,B,C,D,E,F,G,H,I new;
