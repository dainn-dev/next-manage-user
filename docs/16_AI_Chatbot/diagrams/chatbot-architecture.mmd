flowchart TD
    subgraph Clients
        DASH["Dashboard chat widget<br/>(17_Dashboard)"]
        MOB["Mobile app chat sheet<br/>(18_Mobile_App)"]
    end

    subgraph ChatbotModule["chatbot module (modular monolith)"]
        CS["Chat Service<br/>conversation orchestration"]
        PB["Prompt Builder<br/>system prompt + tenant/role context"]
        GR["Guardrail Middleware<br/>tenant isolation, PII filter, rate limit"]
        TR["Tool Router / Executor"]
        RAG["RAG Retriever (optional)<br/>docs/FAQ vector index"]
    end

    subgraph Providers["LLM Provider Adapter (pluggable)"]
        OLLAMA["Ollama (default)<br/>Qwen2.5 / Llama 3.1"]
        HOSTED["Hosted LLM (optional)<br/>Claude / OpenAI"]
    end

    subgraph Tools["Tenant-scoped internal read APIs (/api/v1)"]
        T1["getVehicleLocation()"]
        T2["getHistory()"]
        T3["getSnapshot()"]
        T4["getParkingStatus()"]
    end

    subgraph DataPlane["Data plane"]
        PG[("PostgreSQL + RLS<br/>tenant_id/site_id")]
        OBJ[("Object storage<br/>MinIO/S3 snapshots")]
    end

    subgraph Cross["Cross-cutting"]
        REDIS[("Redis<br/>rate-limit counters")]
        BILLING["05_Subscription_Billing<br/>Plan.limits"]
    end

    DASH --> CS
    MOB --> CS
    CS --> PB
    PB --> GR
    GR --> CS
    CS -->|"tenant-scoped request"| OLLAMA
    CS -.->|"opt-in, plan-gated"| HOSTED
    OLLAMA --> TR
    HOSTED --> TR
    TR --> T1 --> PG
    TR --> T2 --> PG
    TR --> T3 --> OBJ
    TR --> T4 --> PG
    TR -.-> RAG
    GR --> REDIS
    REDIS --> BILLING
