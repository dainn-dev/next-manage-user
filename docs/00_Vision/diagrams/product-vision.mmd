        PI4["Parking-slot mapping\npolygon-based occupancy"]
        PI5["Vehicle relocation detection\nslot-change alerts"]
        PI6["AI chatbot\ntool-calling over tenant data"]
        PI7["Event-driven architecture\nRabbitMQ + outbox"]
        PI8["Realtime dashboards\nWebSocket + STOMP relay"]
        PI9["Docker / Kubernetes deployment\ncloud or on-prem"]
    end

