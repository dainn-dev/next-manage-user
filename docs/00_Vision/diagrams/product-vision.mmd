flowchart TD
    subgraph Problems["Problems in multi-site parking operations"]
        P1["Manual gate staffing per site\nhigh labor cost"]
        P2["No cross-site visibility\nfor operations managers"]
        P3["Vehicles relocate inside a lot\nunclear which slot a car is in"]
        P4["Drivers cannot self-serve\n'where is my car?'"]
        P5["No usage-based cost model\nfor operators with many sites"]
    end

    subgraph Pillars["ParkVision product pillars"]
        PI1["Smart Parking 4.0\nend-to-end automation"]
