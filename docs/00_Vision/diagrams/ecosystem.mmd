    Core --> Bus
    Core --> Cache
    Core --> Object
    Bus --> Chatbot
    Cache -->|pub/sub fan-out| Web

    Core --> Web
    Core --> Mobile
    Web --> Operator
    Web --> PlatformAdmin
    Mobile --> Driver

    Chatbot --> LLMProvider
    Chatbot -->|tenant-scoped tools| Core
    Driver -->|asks| Chatbot
    Operator -->|asks| Chatbot

    Core -->|subscriptions + usage| Payment
    Core -->|events| Notify
    Notify --> Driver
    Notify --> Operator
