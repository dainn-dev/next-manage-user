    Cache["Redis\ncache / presence / STOMP relay"]
    Object["Object storage\nMinIO / S3\nsnapshots"]

    Web["Web dashboard\nNext.js"]
    Mobile["Mobile app\nReact Native (Expo)"]
    Driver["Driver / vehicle owner"]
    Operator["Site manager / security guard"]
    PlatformAdmin["Platform admin"]

    Chatbot["AI Chatbot\nLLM tool-calling"]
    LLMProvider["LLM provider\nOllama (Qwen/Llama) or hosted Claude/OpenAI"]

    Payment["Payment provider\nStripe"]
    Notify["Notification channels\npush (FCM/APNs), email, in-app WS"]

    T1 --> S1
    T2 --> S2
    S1 --> Cam
    S2 --> Cam
