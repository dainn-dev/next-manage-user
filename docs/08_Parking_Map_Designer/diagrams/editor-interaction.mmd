sequenceDiagram
    participant U as "Operator"
    participant FE as "Map Designer (Next.js)"
    participant BE as "Backend API"
    participant DB as "PostgreSQL + PostGIS"

    U->>FE: "Open Site > Parking Map Designer"
    FE->>BE: "GET /api/v1/sites/{id}/cameras?role=OVERVIEW"
    BE-->>FE: "camera list"
    U->>FE: "Select camera, request still frame"
    FE->>BE: "POST /api/v1/cameras/{id}/snapshot"
    BE-->>FE: "background image URL"
    U->>FE: "Draw polygon (pointer events on SVG canvas)"
    FE->>FE: "Client-side validate (min 3 points, in-bounds)"
    U->>FE: "Label slot A01, assign zone"
    U->>FE: "Click Save Draft"
    FE->>BE: "POST /api/v1/sites/{id}/map-versions (draft, slots[])"
    BE->>BE: "Server-side validate (ST_IsValid, ST_Overlaps, frame bbox)"
    BE->>DB: "INSERT SiteMapVersion + ParkingSlot rows"
    DB-->>BE: "OK"
    BE-->>FE: "draft saved"
    U->>FE: "Click Publish"
    FE->>BE: "POST /api/v1/sites/{id}/map-versions/{verId}/publish"
    BE->>DB: "mark previous version archived, new version published"
    BE-->>FE: "published"
