flowchart TD
    A["Select Site + OVERVIEW Camera"] --> B["Capture still frame or upload lot image"]
    B --> C["Load image into SVG/Canvas editor"]
    C --> D["Draw polygon per slot"]
    D --> E["Label slot code (A01, A02, ...)"]
    E --> F["Assign optional Zone"]
    F --> G{"Client-side validate: >=3 vertices, in-bounds?"}
    G -- "No" --> D
    G -- "Yes" --> H["Save Draft Map Version"]
    H --> I{"More slots to draw?"}
    I -- "Yes" --> D
    I -- "No" --> J["Optional: Calibration mode - place homography reference points"]
    J --> K["Handoff reference points to 09_AI_Calibration"]
    K --> L["Click Publish"]
    L --> M{"Server-side validate: no overlaps, valid geometry?"}
    M -- "No" --> D
    M -- "Yes" --> N["Mark version Published, archive previous version"]
