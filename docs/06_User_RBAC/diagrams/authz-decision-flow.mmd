flowchart TD
    Req["Request: action on resource"] --> HasToken{"JWT present & valid?"}
    HasToken -->|"No"| Deny401["401 Unauthorized"]
    HasToken -->|"Yes"| ExtractRole["Extract role, tenant_id, site_ids[]"]

    ExtractRole --> IsPlatform{"role == PLATFORM_ADMIN?"}
    IsPlatform -->|"Yes"| AllowPlatform["Allow (cross-tenant), audit-logged"]
    IsPlatform -->|"No"| TenantMatch{"resource.tenant_id == token.tenant_id?"}

    TenantMatch -->|"No"| Deny403a["403 Forbidden (cross-tenant)"]
    TenantMatch -->|"Yes"| RoleAllows{"Permission matrix:<br/>role has action on resource type?"}

    RoleAllows -->|"No"| Deny403b["403 Forbidden (role lacks permission)"]
    RoleAllows -->|"Yes"| NeedsSite{"resource is site-scoped?"}

    NeedsSite -->|"No"| Allow["Allow"]
    NeedsSite -->|"Yes"| SiteMatch{"resource.site_id in token.site_ids[]?"}

    SiteMatch -->|"No"| Deny403c["403 Forbidden (out of site scope)"]
    SiteMatch -->|"Yes"| Allow

    Allow --> EntCheck["Hand off to EntitlementGuard<br/>(05_Subscription_Billing)"]
