flowchart TD
    start([Login or guard kiosk deep link]) --> identity[Refresh role, account, tenant, assignments, and shift context]
    identity --> guard{Security Guard?}
    guard -->|Yes| shiftState[Resolve current and eligible shift sessions]
    guard -->|Tenant Admin or Site Manager| operatorPolicy[Apply manager operations policy]
    guard -->|Platform Admin| platformLanding[Replace URL with Platform Overview]
    guard -->|Member| memberLanding[Replace URL with Member Home]
    guard -->|Unauthenticated or expired| login[Login with validated relative return path]
    login --> identity

    shiftState --> eligibility{Shift and assignment state}
    eligibility -->|No site assignment| noSite[No assigned site; no shift or operational requests]
    eligibility -->|No eligible shift| noShift[No current shift or gate assignment]
    eligibility -->|One eligible shift| shiftReview[Review fixed shift, site, and gate]
    eligibility -->|Multiple eligible shifts| shiftChoice[Choose only server-returned eligible shift and gate]
    eligibility -->|Active session| resumeShift[Resume after server revalidation]
    eligibility -->|Site or gate disabled| disabled[Disabled site or gate; stop protected activity]
    eligibility -->|Assignment revoked or gate mismatch| unavailable[Generic unavailable state]

    shiftChoice --> shiftReview
    shiftReview --> startConfirm[Confirm locked shift and gate scope]
    startConfirm --> startResult{Idempotent shift start succeeds?}
    startResult -->|Yes| kiosk[Full-screen locked-gate kiosk]
    startResult -->|Conflict or failure| shiftRefresh[Refresh authoritative shift context]
    resumeShift --> kiosk

    kiosk --> bootstrap[REST bootstrap shift access events]
    bootstrap --> subscribe[Authenticated STOMP connect and authorized session subscribe]
    subscribe --> reconcile[Immediate REST reconciliation]
    reconcile --> connection{Connection and data state}
    connection -->|Healthy and reconciled| live[Live monitoring]
    connection -->|Connecting or reconnecting| reconnecting[Show Reconnecting; data non-live]
    connection -->|REST polling| polling[Show Polling and updated time]
    connection -->|Gap or reconcile failure| stale[Show Stale updated time]
    connection -->|No REST or realtime| offline[Offline; disable override, escalation, and handover submit]
    reconnecting --> reconcile
    polling --> reconcile
    stale --> reconcile
    offline --> reconcile

    live --> eventType{Access event state}
    eventType -->|Automatically allowed| normalAllowed[Display allowed event]
    eventType -->|Automatically denied| normalDenied[Display denied event]
    eventType -->|Review required| exception[Open authoritative exception drawer]
    eventType -->|Resolved override| resolved[Display durable outcome]
    eventType -->|Escalated| escalated[Display escalation status]
    eventType -->|Unknown or stale| nonActionable[Display no eligible action]

    exception --> drawer[Snapshot, plate, confidence, access status, recent history, refs, eligibleActions]
    drawer --> verify{Server eligible action}
    verify -->|Allow once| overrideConfirm[Elevated confirm, required reason, evidence acknowledgement]
    verify -->|Deny once| overrideConfirm
    verify -->|Escalate| escalationConfirm[Confirm escalation with mandatory reason]
    verify -->|None| nonActionable

    overrideConfirm --> overrideResult{Version, idempotency, shift, gate, audit and outbox succeed?}
    overrideResult -->|Success| commandState{Gate command state}
    commandState -->|Not required or queued| resolved
    commandState -->|Acknowledged| gateAcknowledged[Show gate command acknowledged]
    commandState -->|Failed| gateFailed[Show override recorded but gate command failed]
    overrideResult -->|Stale or resolved conflict| exceptionRefresh[Refresh event and eligible actions]
    overrideResult -->|Audit or outbox failure| actionFailed[No completion; preserve prior event]

    escalationConfirm --> escalationResult{Source, active shift, idempotency, audit and handoff succeed?}
    escalationResult -->|Success| supervisorHandoff[Site Manager first; Tenant Admin fallback; no directory exposure]
    escalationResult -->|Duplicate, stale, or failure| escalationRecover[Keep safe reason and refresh or retry]
    supervisorHandoff --> escalated

    kiosk --> endShift[Request server-generated versioned handover preview]
    endShift --> handoverPreview[Show counts, overrides, escalations, unresolved events, references]
    handoverPreview --> unresolved{Unresolved or open escalations?}
    unresolved -->|Yes| noteRequired[Require handover note]
    unresolved -->|No| noteOptional[Optional handover note]
    noteRequired --> handoverConfirm[Confirm end shift]
    noteOptional --> handoverConfirm
    handoverConfirm --> handoverResult{Preview version, idempotency, shift end and audit succeed?}
    handoverResult -->|Success| handoverDone[Stop subscriptions and return Guard dashboard with audit reference]
    handoverResult -->|Stale preview| previewRefresh[Refresh handover preview]
    handoverResult -->|Audit or service failure| handoverFailed[Keep shift active; do not claim completion]
    previewRefresh --> endShift

    kiosk --> forbidden[Forbidden CRUD and configuration]
    forbidden --> denied[No users, vehicles, registrations, cameras, gates, maps, credentials, billing, or access-request approval]
    kiosk --> expired[Session expiry or assignment revocation]
    expired --> login

    classDef success fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef warning fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef denied fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    class kiosk,live,drawer,resolved,gateAcknowledged,supervisorHandoff,handoverDone success
    class noSite,noShift,disabled,reconnecting,polling,stale,offline,gateFailed,exceptionRefresh,escalationRecover,previewRefresh,handoverFailed warning
    class platformLanding,memberLanding,unavailable,nonActionable,actionFailed,forbidden,denied denied
