flowchart TD
    start([Login or Tenant Operations deep link]) --> identity[Authenticate and refresh role plus tenant context]
    identity --> tenantAdmin{Tenant Admin?}
    tenantAdmin -->|Yes| scopeLoad[Load authorized sites and resolve URL or stored scope]
    tenantAdmin -->|Platform Admin| platformLanding[Replace URL with Platform Overview]
    tenantAdmin -->|Site Manager or Security Guard| operatorLanding[Apply that role's dashboard policy]
    tenantAdmin -->|Member| memberLanding[Replace URL with Member Home]
    tenantAdmin -->|Unauthenticated or expired| login[Login with validated relative return path]
    login --> identity

    scopeLoad --> siteCount{Authorized site count}
    siteCount -->|Zero| noSite[Show no assigned site; disable operations; recovery guidance]
    siteCount -->|One| fixedSite[Render fixed accessible site scope]
    siteCount -->|Many| siteSelector[Render explicit selected-site and zone selector]
    siteSelector --> scopeValid{URL or selected scope valid?}
    scopeValid -->|No| scopeFallback[Fall back to authorized site; generic feedback]
    scopeValid -->|Yes| dashboard
    fixedSite --> dashboard[Selected-site Tenant Operations Dashboard]
    scopeFallback --> dashboard

    dashboard --> pendingQueue[Primary: pending access-request queue]
    pendingQueue --> queueState{Queue state}
    queueState -->|Pending work| queueDetail[Review request evidence and details]
    queueState -->|Empty| noPending[Show no pending actions]
    queueState -->|Error| queueRetry[Keep dashboard; retry queue locally]
    queueDetail --> queueDecision{Approve or reject?}
    queueDecision -->|Approve| approveConfirm[Confirm selected-site effect]
    queueDecision -->|Reject| rejectConfirm[Confirm with mandatory reason]
    approveConfirm --> decisionResult{Server scope, decision, audit outcome?}
    rejectConfirm --> decisionResult
    decisionResult -->|Success| pendingQueue
    decisionResult -->|Stale, validation, audit, or network failure| decisionRecover[Preserve prior state and retry or refresh]

    dashboard --> kpis[Supporting: occupancy, entries, exits, dwell, camera, map, event summary]
    kpis --> realtime{Realtime state}
    realtime -->|Live| drilldown
    realtime -->|Polling or stale| staleLabel[Show polling or updated time; never claim live]
    staleLabel --> drilldown
    realtime -->|Error| dashboardRetry[Retry failed panels; retain safe data]

    subgraph operations[Selected-site operations]
        direction LR
        drilldown[Operational drilldown] --> events[Events]
        drilldown --> monitoring[Vehicle monitoring]
        drilldown --> entryExit[Entry and exit]
        drilldown --> requests[Access requests]
        drilldown --> maps[Parking maps]
        drilldown --> cameras[Cameras]
        drilldown --> commissioning[Commissioning]
    end

    commissioning --> cameraContext[Resolve selected site, overview camera, zone, image, calibration, map and lock version]
    cameraContext --> mapStatus{Map status}
    mapStatus -->|Draft| draftEdit[Edit draft only]
    mapStatus -->|Published| publishedReadOnly[Published map is read-only preview or archive context]
    mapStatus -->|Archived| archivedCandidate[Archived version can be rollback candidate]
    publishedReadOnly --> createDraft[Create separate draft from source image and valid calibration]
    createDraft --> draftEdit
    draftEdit --> validateMap[Server validate geometry, code, overlap, coverage, zone, camera partition]
    validateMap --> validationResult{Valid?}
    validationResult -->|No| showErrors[Show all validation errors; continue draft edit]
    showErrors --> draftEdit
    validationResult -->|Yes| publishConfirm[Confirm site, camera, draft, version, and impact]
    publishConfirm --> publishResult{If-Match, idempotency, publish, audit outcome?}
    publishResult -->|Success| publishedReadOnly
    publishResult -->|Conflict or failure| publishRecover[Keep draft and offer refresh or retry]
    archivedCandidate --> rollbackConfirm[Confirm archived target with mandatory reason]
    rollbackConfirm --> rollbackResult{Revalidate, rollback, audit outcome?}
    rollbackResult -->|Success| publishedReadOnly
    rollbackResult -->|Reason, conflict, or failure| rollbackRecover[Keep candidate and retry safely]

    subgraph tenantWide[Tenant-wide administration]
        direction LR
        organization[Organization] --> sites[Sites]
        sites --> users[Users, roles, site assignments]
        users --> billing[Billing and audit panel]
    end

    organization --> orgUpdate[Update profile; show durable result when available]
    sites --> siteAction{Create, edit, or delete?}
    siteAction -->|Create| siteRefresh[Wait for server success and refresh before assignment]
    siteAction -->|Delete| siteConfirm[Confirm target, scope, and impact]
    siteConfirm --> siteResult{Server mutation and audit outcome?}
    siteResult -->|Success| sites
    siteResult -->|Failure| siteRecover[Preserve inventory and retry]

    users --> userConfig[Choose identity, canonical role, status, and assignment]
    userConfig --> roleConfig{Role configuration valid?}
    roleConfig -->|PLATFORM_ADMIN| invalidRole[Reject: Platform Admin is unavailable in tenant administration]
    roleConfig -->|Site Manager or Security Guard without site| invalidRole
    roleConfig -->|Unknown, duplicate, or cross-tenant site| invalidRole
    roleConfig -->|Valid| userReview[Review old and new role or site assignment]
    userReview --> userConfirm[Confirm; require reason for removal or deactivation]
    userConfirm --> userResult{Atomic server assignment and audit outcome?}
    userResult -->|Success| users
    userResult -->|Failure| userRecover[Keep prior server state and safe dialog context]

    billing --> billingLoad[Load tenant-wide plan, subscription, usage, and freshness]
    billingLoad --> billingState{Billing state}
    billingState -->|Ready| billingAction{Portal or checkout?}
    billingState -->|Unavailable or stale| billingUnavailable[Show retry; do not infer healthy]
    billingAction --> externalBilling[External Stripe handoff]
    externalBilling --> billingRefresh[Return and refresh server status]
    billingRefresh --> billingLoad
    billing --> auditGap[Future embedded billing audit only after read API contract]

    dashboard --> sessionExpired[Session expiry or 401]
    operations --> sessionExpired
    tenantWide --> sessionExpired
    sessionExpired --> login

    classDef success fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef warning fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef denied fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    class dashboard,pendingQueue,kpis,drilldown,draftEdit,publishedReadOnly,organization,sites,users,billing success
    class noSite,scopeFallback,staleLabel,queueRetry,dashboardRetry,showErrors,publishRecover,rollbackRecover,billingUnavailable warning
    class platformLanding,memberLanding,invalidRole,archivedCandidate denied
