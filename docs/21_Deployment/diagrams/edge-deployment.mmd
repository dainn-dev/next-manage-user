flowchart TB
    subgraph Site["Tenant site (on-prem)"]
        CAM1["Camera 1 (RTSP)"]
        CAM2["Camera 2 (RTSP)"]
        subgraph Appliance["Edge appliance / on-site host"]
            EP1["edge process\n(1 per camera/gate)"]
            EP2["edge process"]
            QUEUE1[("SQLite store-and-forward\nevents.sqlite3")]
            QUEUE2[("SQLite store-and-forward")]
            AGENT["Update agent\n(OTA client)"]
        end
    end

    CAM1 --> EP1
    CAM2 --> EP2
    EP1 --> QUEUE1
    EP2 --> QUEUE2

    QUEUE1 -->|"retry worker,\nexponential backoff"| CLOUD
    QUEUE2 -->|"retry worker"| CLOUD

    subgraph CLOUD["Cloud / regional ingress"]
        ING["Ingress-NGINX"]
        BE["Backend ingest API"]
    end
    CLOUD -->|"X-Gate-Key,\neventId idempotency"| BE

    subgraph Fleet["Fleet management (target)"]
        REG["Device registry\n(gate/camera fleet)"]
        RELEASE["Release channel\n(stable / canary)"]
        OTAPUSH["OTA update push"]
    end
    REG --> RELEASE --> OTAPUSH
    OTAPUSH -->|"outbound poll or\nsigned update pull"| AGENT
    AGENT -->|"applies update,\nreports version"| REG

    NOTE["Edge connects OUTBOUND only\n(no inbound ports on-site)\nsurvives backend/network outage\nvia local queue"]
