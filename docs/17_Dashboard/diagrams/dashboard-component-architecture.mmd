flowchart TD
    subgraph Browser["Next.js 14 App Router (frontend/)"]
        LAYOUT["ProtectedLayout<br/>client-side JWT guard"]
        SWITCH["Site Switcher<br/>Context: currentTenant/currentSite"]
        NAV["Role-based Nav<br/>reads role from decoded JWT (06_User_RBAC)"]

        subgraph Views["Feature views"]
            V_MAP["Parking Map View<br/>SVG overlay (08_Parking_Map_Designer)"]
            V_CAM["Live Camera View<br/>HLS/WebRTC player (07_Camera_Management)"]
            V_MON["Vehicle Monitoring<br/>existing, extended"]
            V_SEARCH["Vehicle Search"]
            V_TIMELINE["Event Timeline"]
            V_ANALYTICS["Analytics Widgets<br/>recharts (20_Analytics)"]
            V_NOTIF["Notifications Center<br/>(19_Notifications)"]
            V_ADMIN["Tenant/Site Admin"]
            V_BILLING["Billing Screens<br/>(05_Subscription_Billing)"]
        end

        subgraph DataLayer["Data access (lib/api/*.ts)"]
            FETCHCLIENTS["hand-rolled fetch clients<br/>native fetch, no axios"]
            CTX["React Context<br/>auth, tenant/site, theme"]
            WSHOOK["hooks/use-websocket.ts<br/>STOMP over SockJS"]
        end
    end

    subgraph Backend["Spring Boot backend"]
        REST["/api/v1 REST controllers"]
        WS["/ws STOMP endpoint<br/>topics: vehicle-check, gate/{id}/check,<br/>+ target: slot-occupancy, notifications"]
    end

    subgraph RealtimeScale["Target: realtime scale-out"]
        REDISPUB["Redis pub/sub<br/>STOMP relay"]
    end

    LAYOUT --> SWITCH --> NAV --> Views
    Views --> FETCHCLIENTS --> REST
    Views --> CTX
    Views --> WSHOOK --> WS
    WS <--> REDISPUB
