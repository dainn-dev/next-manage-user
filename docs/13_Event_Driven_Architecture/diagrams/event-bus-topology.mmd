    RELAY["Outbox Relay<br/>(events module)"] -->|publish, confirm-ack| EX((("Exchange<br/>parkvision.events<br/>type: topic")))

    EX -->|"tenant.site.#"| QDB["q.db-projector"]
    EX -->|"*.*.VehicleEntered<br/>*.*.VehicleExited<br/>*.*.VehicleRelocated<br/>*.*.NotificationSent"| QNOTIFY["q.notification"]
    EX -->|"*.*.SnapshotSaved"| QSNAP["q.snapshot"]
    EX -->|"#"| QANALYTICS["q.analytics"]
    EX -->|"#"| QCHAT["q.chatbot-index"]

    QDB --> CDB["DB Projector<br/>(updates Vehicle.current_slot,<br/>ParkingSlot.status, ParkingHistory)"]
    QNOTIFY --> CNOTIFY["Notification Service<br/>(push / email / WS fan-out)"]
    QSNAP --> CSNAP["Snapshot Archiver<br/>(links Snapshot to object storage)"]
    QANALYTICS --> CANALYTICS["Analytics Aggregator<br/>(occupancy, dwell time, usage metering)"]
    QCHAT --> CCHAT["Chatbot Index Updater<br/>(refreshes tool-call read models)"]

    QDB -.nack / TTL expiry.-> DLX((("DLX<br/>parkvision.events.dlx")))
    QNOTIFY -.nack / TTL expiry.-> DLX
    QSNAP -.nack / TTL expiry.-> DLX
    QANALYTICS -.nack / TTL expiry.-> DLX
    QCHAT -.nack / TTL expiry.-> DLX

    DLX --> DLQ["Per-queue DLQ<br/>q.&lt;name&gt;.dlq<br/>(alerted, manually replayed)"]

