flowchart LR
    Cam["Camera RTSP stream"] --> Edge["Edge appliance (camera worker)"]
    Edge -->|"relay"| Gateway["Media gateway (MediaMTX / go2rtc pattern)"]
    Gateway -->|"HLS segments"| HLS["HLS packager / edge cache"]
    Gateway -->|"WebRTC (low latency)"| WebRTC["WebRTC path"]
    Gateway -->|"MJPEG fallback"| MJPEG["MJPEG snapshot stream"]
    HLS --> Player["Next.js Live-View player"]
    WebRTC --> Player
    MJPEG --> Player
    Player --> Browser["Operator / kiosk browser"]
