flowchart TD
    Action["Tenant attempts an action<br/>(e.g. add camera, add site, send chatbot msg)"] --> Guard["EntitlementGuard interceptor<br/>(billing module, runs after tenant resolution)"]

    Guard --> Lookup["Resolve tenant's active Plan + current usage<br/>(Redis cache: tenant:{id}:entitlements, TTL short)"]
    Lookup --> CacheHit{"Cache hit?"}
    CacheHit -->|"No"| LoadDB["Load Plan.limits jsonb + latest UsageRecord from PostgreSQL"]
    LoadDB --> Cache["Write to Redis cache"]
    Cache --> Compare
    CacheHit -->|"Yes"| Compare["Compare current usage + 1 vs plan limit<br/>for this metric (sites, cameras, AI minutes, chatbot msgs)"]

    Compare --> OverLimit{"Would exceed limit?"}
    OverLimit -->|"No"| Allow["Allow action; proceed to module logic"]
    OverLimit -->|"Yes"| SoftOrHard{"Metric type?"}

    SoftOrHard -->|"Hard limit<br/>(sites, cameras — structural)"| Block["403 Entitlement Exceeded<br/>+ upgrade CTA in response body"]
    SoftOrHard -->|"Soft/metered limit<br/>(AI minutes, chatbot msgs)"| Throttle["Degrade gracefully:<br/>queue at lower priority or<br/>return 429 with retry-after,<br/>never silently drop safety-critical events"]

    Allow --> Emit["Emit UsageRecord increment<br/>(async, off event stream)"]
    Emit --> Notify90{"Usage crosses 80%/100% threshold?"}
    Notify90 -->|"Yes"| Warn["notification module:<br/>'approaching plan limit' alert to TENANT_ADMIN"]
    Notify90 -->|"No"| Done["Continue"]
