flowchart TD
    SLOTS["ParkingSlot polygons\n(site_id, zone_id, code, geometry)"] --> DWELL["Per-slot dwell-time\naccumulator (from ParkingEvent\nVehicleEntered/Exited/Relocated)"]
    DWELL --> BUCKET["Bucket into time windows\n(hourly / daily) per slot"]
    BUCKET --> NORMALIZE["Normalize 0..1 by\nmax dwell in the site"]
    NORMALIZE --> HEATMAP["Heatmap layer overlaid on\nParking-Map Designer canvas\n(08_Parking_Map_Designer)"]

    EVENTS["ParkingEvent stream"] --> OCC["Current occupancy\n= sum(slot.status == occupied)"]
    OCC --> FILL["fill_rate = occupied / total_slots"]
    FILL --> CARD["Occupancy KPI card\n(recharts + stat tile)"]

    HEATMAP --> DASH["Site dashboard (17_Dashboard)"]
    CARD --> DASH
