flowchart TD
    EVT["Incoming domain event\n(type, tenant_id, site_id, severity)"] --> LOOKUP["Resolve interested users\n(vehicle owner, SITE_MANAGER,\nSECURITY_GUARD on-duty)"]
    LOOKUP --> PREF["Load NotificationPreference\nper user x event type"]
    PREF --> ENABLED{"Channel enabled\nfor this event type?"}
    ENABLED -->|"no"| DROP1["Suppress channel"]
    ENABLED -->|"yes"| SEV{"Severity >= user's\nminimum threshold?"}
    SEV -->|"no"| DROP2["Suppress (below threshold)"]
    SEV -->|"yes"| DEDUP{"Same (user, vehicle,\ntype) seen in\nthrottle window?"}
    DEDUP -->|"yes"| DROP3["Suppress duplicate\n(dedup key + TTL in Redis)"]
    DEDUP -->|"no"| ROUTE["Fan out to enabled channels"]
    ROUTE --> WSCH["in-app / WebSocket"]
    ROUTE --> PUSHCH["push (FCM/APNs)"]
    ROUTE --> EMAILCH["email"]
    WSCH --> PERSIST["Persist Notification row\n(read_at = null, sent_at = now)"]
    PUSHCH --> PERSIST
    EMAILCH --> PERSIST
    PERSIST --> INBOX["Notification center\n(frontend, read/unread)"]
