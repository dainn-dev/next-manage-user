flowchart TD
    subgraph Existing["Existing /api resources (kept)"]
        AUTH["/api/auth<br/>login, me, logout"]
        VEH["/api/vehicles<br/>+ check-vehicle (JSON/multipart)"]
        VSTATS["/api/vehicles/statistics"]
        EMP["/api/employees"]
        USR["/api/admin/users"]
        DEPT["/api/departments"]
        POS["/api/positions"]
        VLOG["/api/vehicle-logs<br/>+ export/excel, /csv"]
        AREQ["/api/access-requests"]
        GATE["/api/gates<br/>register, heartbeat, health,<br/>{id}/recent-checks"]
    end

    subgraph V1["New /api/v1 resources (SaaS)"]
        TEN["/api/v1/tenants"]
        SITE["/api/v1/sites"]
        ZONE["/api/v1/zones"]
        CAM["/api/v1/cameras"]
        SLOT["/api/v1/parking-slots"]
        V1VEH["/api/v1/vehicles<br/>+ current location"]
        PEVT["/api/v1/parking-events<br/>(ingest)"]
        SNAP["/api/v1/snapshots"]
        SUB["/api/v1/subscriptions"]
        NOTIF["/api/v1/notifications"]
        ANLY["/api/v1/analytics"]
        CHAT["/api/v1/chat"]
    end

    subgraph RT["Realtime (STOMP over /ws)"]
        TOPIC1["/topic/vehicle-check"]
        TOPIC2["/topic/gate/{gateId}/check"]
        TOPIC3["/topic/site/{siteId}/slots"]
        TOPIC4["/topic/tenant/{tenantId}/notifications"]
    end

    TEN --> SITE --> ZONE --> SLOT
    SITE --> CAM
    CAM --> GATE
    V1VEH --> SLOT
    PEVT --> SNAP
    PEVT --> TOPIC3
    PEVT --> TOPIC4
    GATE -.legacy alias of.-> CAM
    VEH -.evolves into.-> V1VEH
    VLOG -.superseded by.-> PEVT
    AREQ -.folds into.-> V1VEH

    CHAT -->|tool calls| V1VEH
    CHAT -->|tool calls| PEVT
    CHAT -->|tool calls| SNAP
    CHAT -->|tool calls| SLOT
