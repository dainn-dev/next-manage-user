flowchart LR
    COMMIT["Commit / PR"] --> LINT["Lint + static analysis"]
    LINT --> UNIT["Unit tests\nJUnit (backend)\nvitest/RTL (frontend)\npytest (edge)"]
    UNIT --> INTEG["Integration tests\nTestcontainers:\nPostgres + RabbitMQ + Redis"]
    INTEG --> CONTRACT["Contract tests\nOpenAPI-driven:\ningest API + REST API"]
    CONTRACT --> EDGERES["Edge resilience suite\n(store-and-forward,\ntest_edge_resilience.py)"]
    EDGERES --> COVERAGE{"Coverage gate\nmet?"}
    COVERAGE -->|"no"| FAIL1["Fail build"]
    COVERAGE -->|"yes"| BUILD["Build & scan images"]
    BUILD --> DEPLOYSTG["Deploy to staging"]
    DEPLOYSTG --> E2E["E2E (Playwright)\ndashboard flows"]
    DEPLOYSTG --> LOADTEST["Load/perf test\n(events/sec per site)"]
    DEPLOYSTG --> TENANTTEST["Multi-tenant isolation\n(RLS) tests"]
    DEPLOYSTG --> SECTEST["Security tests\n(SAST/DAST, dep scan)"]
    E2E --> GATE{"All staging gates green?"}
    LOADTEST --> GATE
    TENANTTEST --> GATE
    SECTEST --> GATE
    GATE -->|"no"| FAIL2["Block promotion"]
    GATE -->|"yes"| PROMOTE["Promote to prod\n(21_Deployment CI/CD)"]
