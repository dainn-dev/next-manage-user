flowchart TB
    subgraph Pyramid["ParkVision test pyramid"]
        direction TB
        E2E["E2E (Playwright)\ndashboard critical paths\nfewest, slowest"]
        LOAD["Load / perf\nevents/sec per site\ngates events/sec"]
        CONTRACT["Contract tests\ningest API + REST API\n(OpenAPI-driven)"]
        INTEG["Integration\n(Testcontainers: Postgres,\nRabbitMQ, Redis)"]
        UNIT["Unit\n(JUnit backend, vitest/RTL\nfrontend, pytest edge)\nmost, fastest"]
    end

    UNIT --> INTEG --> CONTRACT --> LOAD --> E2E

    subgraph Cross["Cross-cutting (run alongside the pyramid, not layered)"]
        AIEVAL["AI/ML evaluation\n(OCR, detection mAP,\nslot-mapping, relocation FP rate)"]
        EDGERES["Edge resilience\n(store-and-forward,\ntest_edge_resilience.py)"]
        TENANT["Multi-tenant isolation\n(RLS)"]
        SEC["Security testing"]
    end

    classDef current fill:#eef,stroke:#448,stroke-width:1px;
    classDef target fill:#efe,stroke:#484,stroke-width:1px;
    class UNIT,EDGERES current;
    class INTEG current;
    class CONTRACT,LOAD,E2E,AIEVAL,TENANT,SEC target;
