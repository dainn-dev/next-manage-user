flowchart TD
    A["Select Site + Camera"] --> B["Capture reference still frame"]
    B --> C["Draw ROI / exclusion mask"]
    C --> D["Tune motion sensitivity (MOG2 var threshold, min contour area)"]
    D --> E["Set detection thresholds: confidence_threshold, min_detection_duration, cooldown, frame_interval_ms"]
    E --> F["Choose OCR engine + min_confidence"]
    F --> G["Enter homography reference points (image px <-> world plane)"]
    G --> H["Link to slots from 08_Parking_Map_Designer"]
    H --> I["Capture day/night/weather profile variants"]
    I --> J["Run test pass against sample frames"]
    J --> K{"Results acceptable?"}
    K -- "No" --> C
    K -- "Yes" --> L["Publish calibration_json to Camera"]
    L --> M["Edge pulls new calibration on next sync"]
