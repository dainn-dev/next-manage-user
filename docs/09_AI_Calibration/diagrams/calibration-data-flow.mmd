sequenceDiagram
    participant Op as "Operator"
    participant FE as "Calibration Wizard (Next.js)"
    participant BE as "Backend API"
    participant DB as "PostgreSQL (Camera.calibration_json)"
    participant Edge as "Edge camera worker"

    Op->>FE: "Complete calibration wizard steps"
    FE->>BE: "PUT /api/v1/cameras/{id}/calibration (calibration_json)"
    BE->>DB: "UPDATE Camera SET calibration_json, calibration_version += 1"
    BE-->>FE: "200 OK (calibration_version)"
    loop "on heartbeat / periodic sync"
        Edge->>BE: "POST /api/v1/cameras/{id}/heartbeat (local_calibration_version)"
        BE-->>Edge: "ack (server_calibration_version)"
        alt "server_calibration_version > local"
            Edge->>BE: "GET /api/v1/cameras/{id}/calibration"
            BE-->>Edge: "calibration_json"
            Edge->>Edge: "reload ROI mask, motion params, thresholds, homography matrix"
            Edge->>Edge: "cache calibration_json to local disk (offline-safe)"
        end
    end
