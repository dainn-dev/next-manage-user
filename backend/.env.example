# ========================================
# BACKEND (Spring Boot) ENVIRONMENT TEMPLATE
# ========================================
# Copy this file to backend/.env and fill in real values for local development.
# Real secrets belong in backend/.env (never committed) - this file only holds
# placeholders. See ENVIRONMENT_SETUP.md for full guidance.
#
# Spring Boot reads these via relaxed binding, so SPRING_DATASOURCE_URL maps to
# spring.datasource.url and JWT_SECRET maps to jwt.secret in application.yml.

# ---- Server ----
SERVER_PORT=8080

# ---- Database (PostgreSQL) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vehicle_management
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# ---- JWT ----
# At least 256 bits long for HS256. Use a strong, unique value in production.
JWT_SECRET=replace-with-a-strong-secret-of-at-least-256-bits
JWT_EXPIRATION=86400