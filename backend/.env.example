# ========================================
# BACKEND (Spring Boot) ENVIRONMENT TEMPLATE
# ========================================
# Copy this file to backend/.env and fill in real values for local development.
# Real secrets belong in backend/.env (never committed) - this file only holds
# placeholders. See ENVIRONMENT_SETUP.md for full guidance.
#
# Spring Boot reads these via relaxed binding, so SPRING_DATASOURCE_URL maps to
# spring.datasource.url and JWT_SECRET maps to jwt.secret in application.yml.

# ---- Server ----
SERVER_PORT=8080

# ---- Database (PostgreSQL) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vehicle_management
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Separate platform-admin pool. The Flyway migration creates app_admin_login and
# grants it the app_admin role; set its password outside source control.
APP_ADMIN_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vehicle_management
APP_ADMIN_DATASOURCE_USERNAME=app_admin_login
APP_ADMIN_DATASOURCE_PASSWORD=change-me

# ---- JWT ----
# At least 256 bits long for HS256. Use a strong, unique value in production.
JWT_SECRET=replace-with-a-strong-secret-of-at-least-256-bits
JWT_EXPIRATION=86400

# ---- Password reset ----
# HMAC fingerprint secret for password-reset rate limiting. Required at boot (32+ chars).
PASSWORD_RESET_FINGERPRINT_SECRET=replace-with-a-strong-secret-of-at-least-32-chars
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Stripe Billing (DAI-275)
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Gate API key ----
# Shared secret required in the X-Gate-Key header for the public, side-effecting
# endpoints called by the parking-gate detection app:
#   POST /api/vehicles/check-vehicle   (vehicle status + WS push)
#   POST /api/vehicle-logs             (log entry from the gate)
# When left empty the backend runs these endpoints OPEN (dev only). Set a strong
# value in production and distribute the same value to the detection app / GATE_API_KEY.
GATE_API_KEY=replace-with-a-strong-gate-key
