# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Agent/IDE metadata — never commit per-install generated skills/context
.agents/
.agent_context/
AGENTS.md

# dependencies (root + any package, e.g. frontend/)
node_modules/

# next.js (frontend/ lives in a subdirectory now)
.next/
out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# edge app (Python LP detector, renamed from windows/)
edge/result/
edge/build/
edge/dist/
edge/__pycache__/
edge/**/__pycache__/
edge/*.pyc
edge/model/*.pt
edge/tools/pipeline_eval/reports/
# edge runtime state / secrets — never commit (use config.example.json as the template)
edge/config.json
edge/license_plates.json
edge/temp_speech.mp3
.venv_build/
.opencode/*
.claude/*
.agents/*
